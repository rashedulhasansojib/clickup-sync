{
  "name": "clickup-sync-nestjs",
  "version": "0.1.0",
  "description": "NestJS backend replacement for n8n ClickUp to PostgreSQL sync workflows.",
  "private": true,
  "license": "UNLICENSED",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \"prisma/**/*.prisma\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "lint": "eslint \"{src,test}/**/*.ts\"",
    "test": "node --max-old-space-size=4096 node_modules/jest/bin/jest.js --runInBand",
    "test:e2e": "node test/run-e2e.js",
    "test:watch": "jest --watch",
    "prisma:generate": "prisma generate --config ./prisma.config.ts",
    "prisma:migrate": "prisma migrate dev --config ./prisma.config.ts",
    "prisma:deploy": "prisma migrate deploy --config ./prisma.config.ts",
    "prisma:studio": "prisma studio --config ./prisma.config.ts",
    "dev:deps": "docker compose up -d postgres redis",
    "dev:reset": "docker compose down -v && docker compose up -d postgres redis && npm run prisma:deploy",
    "dev:web": "pnpm --filter web dev",
    "build:web": "pnpm --filter web build",
    "dev:all": "concurrently \"npm run start:dev\" \"npm run dev:web\"",
    "dev:meetsy": "concurrently \"pnpm --filter @ma/api dev\" \"pnpm --filter @ma/web dev\"",
    "dev:platform": "npm run dev:deps && concurrently -k -n clicksy-api,clicksy-web,meetsy-api,meetsy-web -c blue,cyan,magenta,green \"npm run start:dev\" \"pnpm --filter web dev\" \"pnpm --filter @ma/api dev\" \"pnpm --filter @ma/web dev\"",
    "turbo:build": "turbo run build",
    "turbo:typecheck": "turbo run typecheck",
    "turbo:lint": "turbo run lint"
  },
  "dependencies": {
    "@nestjs/axios": "4.0.1",
    "@nestjs/bullmq": "11.0.4",
    "@nestjs/common": "11.1.19",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.1.19",
    "@nestjs/platform-express": "11.1.19",
    "@nestjs/schedule": "6.1.3",
    "@nestjs/serve-static": "^5.0.5",
    "@nestjs/swagger": "11.4.2",
    "@nestjs/terminus": "11.1.1",
    "@nestjs/throttler": "6.4.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "7.8.0",
    "axios": "1.16.0",
    "bullmq": "5.76.6",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "compression": "1.8.1",
    "cookie-parser": "1.4.7",
    "dotenv": "17.4.1",
    "helmet": "8.1.0",
    "nodemailer": "6.10.0",
    "pg": "^8.20.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.21",
    "@nestjs/schematics": "11.1.0",
    "@nestjs/testing": "11.1.19",
    "@types/compression": "1.8.1",
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/node": "25.6.2",
    "@types/nodemailer": "^6.4.17",
    "@types/pg": "^8.20.0",
    "@types/supertest": "7.2.0",
    "concurrently": "^9.1.0",
    "eslint": "10.3.0",
    "globals": "^17.5.0",
    "jest": "30.4.2",
    "prettier": "3.8.3",
    "prisma": "7.8.0",
    "supertest": "7.2.2",
    "ts-jest": "29.4.9",
    "tsx": "4.21.0",
    "turbo": "^2.3.0",
    "typescript": "6.0.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testRegex": ".*\\.spec\\.ts$",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "\\.e2e\\.spec\\.ts$"
    ],
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "src/**/*.(t|j)s"
    ],
    "coverageDirectory": "coverage",
    "testEnvironment": "node"
  }
}
