# ── App ──────────────────────────────────────────────────────────────────────
NODE_ENV=development
# 3002, not 3000: on Windows/WSL a wslrelay process squats port 3000 and the
# dashboard then crashes with a confusing `.reduce is not a function`.
PORT=3002

# ── Database ──────────────────────────────────────────────────────────────────
# Local PostgreSQL (docker-compose default)
DATABASE_URL=postgresql://clickup:clickup@localhost:5433/clickup_sync?schema=public

# Production (docker-compose.prod.yml) — talk to the `postgres` service by name on
# the internal network. The password below MUST equal POSTGRES_PASSWORD.
# DATABASE_URL=postgresql://clickup:<POSTGRES_PASSWORD>@postgres:5432/clickup_sync?schema=public

# Neon (cloud) — uncomment and fill in for managed Postgres
# DATABASE_URL=postgresql://<user>:<password>@<host>.neon.tech/<db>?sslmode=require&channel_binding=require

# ── Redis ─────────────────────────────────────────────────────────────────────
# Local dev:
REDIS_URL=redis://localhost:6379
# Production (docker-compose.prod.yml): use the service name on the internal network
# REDIS_URL=redis://redis:6379

# ── ClickUp ───────────────────────────────────────────────────────────────────
# NOTE: These ClickUp values are now MANAGED IN THE DASHBOARD (Settings →
# Connection) and stored in the database. The env vars below are only used as
# the initial fallback until you save values in the UI — a fresh instance can
# boot with them blank and be configured from the browser.
#
# Use a Workspace Owner/Admin service account token (required for time-entry writes on behalf of assignees)
CLICKUP_API_TOKEN=
CLICKUP_TEAM_ID=3450636
# CLICKUP_TEAM_ID=3450636 (Nifty)
# CLICKUP_TEAM_ID= 9017121201 (Denowatts).

# Public HTTPS URL this service is reachable at — used when registering the webhook with ClickUp
CLICKUP_WEBHOOK_ENDPOINT=https://your-domain.com/api/webhooks/clickup

# Webhook signing secret. Usually set via the dashboard (Register webhook) and stored
# encrypted in the DB; leave blank unless seeding from an existing webhook.
CLICKUP_WEBHOOK_SECRET=

# Comma-separated list of ClickUp event types to subscribe to.
# taskStatusUpdated is required for the cycle-time / time-in-status reports — omitting
# it silently leaves those reports empty. Keep in sync with env.validation.ts's default.
# taskCommentPosted / taskCommentUpdated drive live ClickUp comment capture into
# clickup_task_comments.
CLICKUP_WEBHOOK_EVENTS=taskCreated,taskUpdated,taskDeleted,taskTimeTrackedUpdated,taskStatusUpdated,taskCommentPosted,taskCommentUpdated

# ── Admin ─────────────────────────────────────────────────────────────────────
# Set a strong random string before deploying (e.g. openssl rand -hex 32)
ADMIN_API_KEY=

# Key used to encrypt settings secrets (ClickUp token, webhook secret) at rest in
# the database. REQUIRED in production. Generate with: openssl rand -hex 32
APP_ENCRYPTION_KEY=

# ── Worker / Queue tuning ─────────────────────────────────────────────────────
JOB_ATTEMPTS=5
JOB_BACKOFF_DELAY_MS=30000
# The reconciliation cadence + lookback are hardcoded in src/sync/sync.scheduler.ts
# (hourly; 1-day task / 7-day time-entry window) — not env-tunable.
# BullMQ rate limit for ClickUp-facing workers (jobs per window) so the API's
# rate limit isn't exceeded, esp. if worker concurrency is raised.
CLICKUP_JOB_RATE_MAX=30
CLICKUP_JOB_RATE_DURATION_MS=60000

# Expose Swagger at /docs. Off in production unless set to true (the schema is
# served unauthenticated, so leave it false in prod).
ENABLE_SWAGGER=false

# ── Production deploy (docker-compose.prod.yml only) ───────────────────────────
# Public hostname Caddy serves + provisions TLS for. DNS must point here.
DOMAIN=clickup-sync.example.com
# Password for the bundled Postgres container. Must match the password inside
# DATABASE_URL above. Generate with: openssl rand -hex 24
POSTGRES_PASSWORD=

# ── Auth / orgs / email ────────────────────────────────────────────────────────
DEFAULT_ORG_NAME=Default Org
SESSION_MAX_AGE_DAYS=30
SESSION_IDLE_TIMEOUT_DAYS=7
APP_BASE_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="ClickUp Sync <no-reply@example.com>"

# Parent-domain scope for the session + csrf cookies so a Clicksy login also
# authenticates the Meetsy sibling app at meetsy.<domain>. Leave BLANK for
# localhost (host-only cookie). In prod set to a leading-dot parent, e.g.
# COOKIE_DOMAIN=.example.com
COOKIE_DOMAIN=

# ── Meetsy (apps/meetsy-api) ───────────────────────────────────────────────────
# Meetsy shares this Postgres but connects as the least-privilege `meetsy` role
# (see apps/meetsy-api/prisma/grants.sql): it OWNS the `meetsy` schema and reads
# Clicksy's public.users/sessions/workspaces read-only. Same host/db as
# DATABASE_URL, different user.
MEETSY_DATABASE_URL=postgresql://meetsy:meetsy@localhost:5433/clickup_sync
# Comma-separated origins allowed to send the shared cookie to meetsy-api
# (Clicksy dashboard + Meetsy web). credentials:true CORS.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
# Meetsy reuses the SAME APP_ENCRYPTION_KEY value as Clicksy (above) — needed in
# Phase 1 to decrypt the shared ClickUp token. Do not set a second key.
# Meetsy reads SESSION_MAX_AGE_DAYS / SESSION_IDLE_TIMEOUT_DAYS (above) and the
# optional ADMIN_API_KEY (above) too; no Meetsy-specific copies needed.
# Azure OpenAI vars for the Meetsy pipeline (CHAT). Reused as-is — do NOT add a
# second set. Chat lives on the niftyai.openai.azure.com resource.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=

# Azure OpenAI — EMBEDDINGS. A SEPARATE Azure resource from chat above
# (niftyocr.openai.azure.com / text-embedding-3-large, dimensions=1024 honored).
# Wired in Phase 0 but UNUSED until Phase 2 (RAG) — all optional; meetsy-api
# boots without them and only errors if embed() is actually called unconfigured.
AZURE_EMBED_ENDPOINT=
AZURE_EMBED_API_KEY=
AZURE_EMBED_DEPLOYMENT=text-embedding-3-large
AZURE_EMBED_API_VERSION=2023-05-15

# meetsy-web → Clicksy login redirect. An unauthenticated Meetsy visitor is sent
# to Clicksy's login, which bounces back after sign-in. Baked into the web bundle
# (NEXT_PUBLIC_*) at build time. Prod e.g. https://app.example.com/login
NEXT_PUBLIC_CLICKSY_LOGIN_URL=http://localhost:5173/login
