{
  "name": "@ma/api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "dotenv -e ../../.env -- nest start --watch",
    "build": "nest build",
    "start": "dotenv -e ../../.env -- node dist/main",
    "test": "jest --runInBand",
    "typecheck": "tsc --noEmit",
    "lint": "echo \"(no lint configured)\"",
    "db:generate": "dotenv -e ../../.env -- prisma generate",
    "db:migrate": "dotenv -e ../../.env -- prisma migrate dev",
    "db:deploy": "dotenv -e ../../.env -- prisma migrate deploy",
    "probe:azure": "dotenv -e ../../.env -- ts-node scripts/probe-azure.ts"
  },
  "dependencies": {
    "@clicksy/shared": "workspace:*",
    "@ma/shared": "workspace:*",
    "@nestjs/common": "^10.4.4",
    "@nestjs/core": "^10.4.4",
    "@nestjs/platform-express": "^10.4.4",
    "@prisma/client": "^5.22.0",
    "bullmq": "^5.21.2",
    "cookie-parser": "^1.4.7",
    "ioredis": "^5.4.1",
    "multer": "1.4.5-lts.1",
    "nestjs-pino": "^4.6.1",
    "openai": "^4.73.0",
    "pdf-parse": "1.1.1",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.5",
    "@nestjs/schematics": "^10.2.3",
    "@nestjs/testing": "^10.4.4",
    "@types/cookie-parser": "^1.4.8",
    "@types/jest": "30.0.0",
    "@types/multer": "^2.1.0",
    "@types/node": "^20.16.11",
    "@types/pdf-parse": "^1.1.5",
    "dotenv-cli": "^7.4.2",
    "jest": "30.4.2",
    "prisma": "^5.22.0",
    "ts-jest": "29.4.9",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testRegex": ".*\\.spec\\.ts$",
    "testPathIgnorePatterns": [
      "/node_modules/"
    ],
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "src/**/*.(t|j)s"
    ],
    "coverageDirectory": "coverage",
    "testEnvironment": "node"
  }
}
