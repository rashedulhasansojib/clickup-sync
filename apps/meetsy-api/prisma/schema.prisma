// Prisma schema for the Meetsy API.
//
// Multi-schema, shared Postgres: Meetsy OWNS the `meetsy` schema (its meeting
// pipeline tables) and READS Clicksy's `public` schema (users/sessions/workspaces)
// through a least-privilege role (see prisma/grants.sql). The `public.*` models
// below are UNMANAGED read-only mirrors — Meetsy migrations must NEVER create or
// alter them. They exist only so the Prisma client can validate cookie sessions
// and resolve the default workspace.
//
// Identity (Org/User) comes from `public` — Meetsy has no own identity tables.
// Meeting/AnalysisRun/Feedback/ChatMessage carry `orgId`/`workspaceId` as plain
// String columns (SOFT references to public — no cross-schema DB FK, per the
// read-only boundary; existence is checked in application code).

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("MEETSY_DATABASE_URL")
  schemas  = ["meetsy", "public"]
}

// ---------------------------------------------------------------------------
// meetsy schema — managed by Meetsy migrations
// ---------------------------------------------------------------------------

enum RunStatus {
  queued
  running
  completed
  failed

  @@schema("meetsy")
}

enum TaskVote {
  up
  down

  @@schema("meetsy")
}

enum ChatRole {
  user
  assistant

  @@schema("meetsy")
}

// Outcome of pushing a single Meetsy task to ClickUp.
enum PushStatus {
  pushed
  failed
  skipped

  @@schema("meetsy")
}

// Source of a KB chunk. Phase 2a only embeds `clickup_task`; `transcript` and
// `document` are reserved for 2a.1 / 2b and unused now.
enum KbSourceType {
  clickup_task
  transcript
  document

  @@schema("meetsy")
}

model Meeting {
  id          String  @id @default(cuid())
  // Soft references to public (no DB FK): org owns users, workspace owns meetings.
  orgId       String
  workspaceId String  @map("workspace_id")
  title       String
  // Raw uploaded transcript (plain text or Zoom VTT).
  transcript  String  @db.Text
  // Deterministically normalized transcript (VTT parsed to clean timestamped
  // turns). The pipeline analyzes this; null for legacy rows.
  normalizedTranscript String? @db.Text
  // The date the meeting took place — anchor for resolving relative due dates.
  meetingDate DateTime?
  // Confirmed participant roster (Participant[] from @ma/shared). Null until the
  // user confirms the Stage-0 extracted roster via POST /meetings/:id/roster.
  roster      Json?
  createdAt   DateTime @default(now())

  runs AnalysisRun[]

  @@index([orgId])
  @@index([workspaceId])
  @@schema("meetsy")
}

model AnalysisRun {
  id          String    @id @default(cuid())
  orgId       String
  workspaceId String    @map("workspace_id")
  meetingId   String
  status      RunStatus @default(queued)
  // Stores the AnalysisResult shape (@ma/shared) once the pipeline completes.
  result      Json?
  error       String?
  // True once the user has accepted the result (or left it unreviewed = default
  // accepted). Downvoted/commented tasks trigger a targeted re-run.
  accepted    Boolean   @default(false)
  // Observability: LLM usage accumulated across the pipeline for this run.
  promptTokens     Int @default(0)
  completionTokens Int @default(0)
  llmCalls         Int @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  meeting      Meeting       @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  feedback     Feedback[]
  chatMessages ChatMessage[]

  @@index([orgId])
  @@index([workspaceId])
  @@index([meetingId])
  @@schema("meetsy")
}

// Per-task user feedback on a run's result.
model Feedback {
  id        String   @id @default(cuid())
  orgId     String
  runId     String
  taskId    String
  vote      TaskVote
  comment   String?  @db.Text
  createdAt DateTime @default(now())

  run AnalysisRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId])
  @@index([orgId])
  @@schema("meetsy")
}

// Chat-over-result conversation, scoped to a run.
model ChatMessage {
  id        String   @id @default(cuid())
  orgId     String
  runId     String
  role      ChatRole
  content   String   @db.Text
  createdAt DateTime @default(now())

  run AnalysisRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId])
  @@schema("meetsy")
}

// Per-workspace ClickUp write-back configuration: the default target list new
// tasks are created in, plus the allowlist of members Meetsy may assign. Owned
// and managed by Meetsy; workspaceId is a soft ref to public.workspaces.
model WorkspacePushConfig {
  id                String   @id @default(cuid())
  workspaceId       String   @unique
  targetListId      String
  targetListName    String?
  // [{ clickupUserId, name, email }] — the ONLY people Meetsy may offer as an
  // assignee. Anyone not in this list is never assigned.
  assignableMembers Json
  // Optional ClickUp status for new tasks; null = use the list's default.
  defaultStatus     String?
  // Phase 2c.3 HITL fields — populated by the "refresh ClickUp field options"
  // action (fetched from ClickUp), confirmed per-task on the push.
  // The client dropdown custom field: its id + its options [{optionId(UUID),name}].
  clientFieldId     String?
  clientFieldName   String?
  clientOptions     Json?
  // Selectable sprint target lists [{listId,name}] (Sprints ClickApp = a sprint
  // is its list; we never create lists). The push routes via the chosen listId.
  sprintLists       Json?
  // Whether to offer the top-level `points` field on the push.
  pointsEnabled     Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  updatedBy         String?

  @@schema("meetsy")
}

// Phase 2c.3 — the human's accept/override of each weak field prediction, logged
// at push time. NOT read yet — it's the Phase-3 learning signal. One row per
// pushed task: `predicted` is the 2c.2 fieldPredictions bundle, `confirmed` is
// what the user actually pushed (client/sprint/points/assignee).
model FieldOverride {
  id           String   @id @default(cuid())
  runId        String
  meetsyTaskId String
  workspaceId  String
  predicted    Json?
  confirmed    Json
  createdAt    DateTime @default(now())

  @@index([workspaceId])
  @@index([runId])
  @@schema("meetsy")
}

// Audit trail + idempotency ledger for ClickUp task pushes. One row per
// (runId, meetsyTaskId): a `pushed` row is the dedupe key so a re-push never
// creates a duplicate ClickUp task.
model TaskPush {
  id            String     @id @default(cuid())
  runId         String
  meetsyTaskId  String
  workspaceId   String
  clickupTaskId String?
  clickupUrl    String?
  status        PushStatus
  error         String?
  // The ClickUp create payload that was (or would have been) sent.
  payload       Json
  pushedBy      String
  createdAt     DateTime   @default(now())

  @@unique([runId, meetsyTaskId])
  @@index([workspaceId])
  @@schema("meetsy")
}

// One embedded chunk of the per-workspace RAG knowledge base. Phase 2a embeds
// one "card" per ClickUp task (chunkIndex 0); the schema reserves multi-chunk
// (long tasks) + transcript/document sources for later.
//
// NOTE: two DB-level columns are NOT modeled here because Prisma can't express
// them — the migration HAND-ADDS them:
//   - `embedding` is `Unsupported("vector(1024)")?` (pgvector); writes go through
//     a raw `$executeRaw` upsert that casts a '[...]' literal to ::vector.
//   - `tsv` (a generated `tsvector` column from `content`, for the keyword half
//     of hybrid search) has no Prisma field at all; it exists only in the DB.
model KbChunk {
  id          String       @id @default(cuid())
  workspaceId String
  sourceType  KbSourceType
  // For clickup_task this is the ClickUp `task_id`.
  sourceId    String
  chunkIndex  Int          @default(0)

  // The embedded card text + its sha256 — the incremental-refresh gate.
  content     String  @db.Text
  contentHash String

  // pgvector column; the migration adds the real `vector(1024)` + the HNSW index.
  embedding   Unsupported("vector(1024)")?

  // Filter metadata (workspace scope today; facet filters in 2c).
  status        String?
  assignee      String?
  component     String?
  client        String?
  department    String?
  taskUpdatedAt DateTime?

  // Model provenance — a future model/dim bump becomes a controlled re-embed.
  embeddingModel   String?
  embeddingDims    Int
  embeddingVersion Int      @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([workspaceId, sourceType, sourceId, chunkIndex])
  @@index([workspaceId, sourceType])
  @@schema("meetsy")
}

// Phase 2a.1 "what we learned" summary card. One cached row per workspace:
// `facts` is the exact aggregate SQL output (KbFacts JSON), `narrative` the single
// gpt-5.4-mini paragraph (null when Azure is unavailable). `taskCountAtGen` is the
// embedded chunk count at generation time — the staleness gate for regeneration.
model KbSummary {
  workspaceId    String   @id
  facts          Json
  narrative      String?  @db.Text
  taskCountAtGen Int      @default(0)
  generatedAt    DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@schema("meetsy")
}

// Per-workspace onboarding cursor + status for the KB embed worker.
model KbSyncState {
  workspaceId    String    @id
  // High-water mark on ClickUp `updated_date`; only rows past it are re-scanned.
  lastTaskCursor DateTime?
  embeddedCount  Int       @default(0)
  // idle | onboarding | ready | error
  status         String    @default("idle")
  lastRunAt      DateTime?

  @@schema("meetsy")
}

// Phase 2b — an uploaded context document (SOP / scope / spec PDF or text).
// Its chunks live in KbChunk (sourceType=document, sourceId=this.id). We persist
// the EXTRACTED TEXT (to re-chunk on a future model bump) and discard raw bytes;
// `sha256` (over the raw bytes) is the idempotency/dedup key.
model KbDocument {
  id            String  @id @default(cuid())
  workspaceId   String
  filename      String
  mimeType      String
  // sha256 of the raw uploaded bytes — re-upload of identical bytes is a no-op.
  sha256        String
  byteSize      Int
  pageCount     Int?
  charCount     Int     @default(0)
  chunkCount    Int     @default(0)
  // Extracted plain text (kept so a model/dim bump can re-chunk without the file).
  extractedText String? @db.Text
  // pending | parsing | embedding | ready | error
  status        String  @default("pending")
  error         String? @db.Text
  // The honest improvement metric output (novelty + answerability-lift), JSON.
  // See KbDocMetric in the app — reported as two never-blended signals.
  metric        Json?
  // Soft ref to public.users (session user); no FK across the read-only boundary.
  uploadedBy    String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  links KbDocTaskLink[]

  @@unique([workspaceId, sha256])
  @@index([workspaceId])
  @@schema("meetsy")
}

// Phase 2b — auto-discovered doc↔task relatedness (seed for 2c context injection).
// `taskId` is a PLAIN string soft-ref to public.clickup_tasks.task_id (no FK, no
// public write). `score` is the cosine that produced the link.
model KbDocTaskLink {
  id          String   @id @default(cuid())
  workspaceId String
  documentId  String
  taskId      String
  score       Float
  createdAt   DateTime @default(now())

  document KbDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, taskId])
  @@index([workspaceId, taskId])
  @@schema("meetsy")
}

// ---------------------------------------------------------------------------
// public schema — UNMANAGED read-only mirrors of Clicksy's tables.
// Column names/maps MUST match Clicksy's prisma/schema.prisma exactly.
// Meetsy never writes these (enforced by DB grant). Mirror ONLY what Meetsy reads.
// ---------------------------------------------------------------------------

enum Role {
  OWNER
  ADMIN
  MEMBER

  @@schema("public")
}

enum UserStatus {
  ACTIVE
  DISABLED

  @@schema("public")
}

enum WorkspaceStatus {
  ACTIVE
  DISABLED

  @@schema("public")
}

model User {
  id     String     @id @default(cuid())
  orgId  String     @map("org_id")
  email  String     @unique
  name   String?
  role   Role       @default(MEMBER)
  status UserStatus @default(ACTIVE)

  sessions Session[]

  @@map("users")
  @@schema("public")
}

model Session {
  id         String    @id @default(cuid())
  userId     String    @map("user_id")
  tokenHash  String    @unique @map("token_hash")
  expiresAt  DateTime  @map("expires_at")
  lastSeenAt DateTime? @map("last_seen_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
  @@schema("public")
}

model Workspace {
  id                 String          @id @default(cuid())
  orgId              String          @map("org_id")
  name               String
  clickupTeamId      String          @map("clickup_team_id")
  clickupApiTokenEnc String?         @map("clickup_api_token_enc")
  isDefault          Boolean         @default(false) @map("is_default")
  status             WorkspaceStatus @default(ACTIVE)

  @@index([orgId])
  @@map("workspaces")
  @@schema("public")
}

// Per-workspace ClickUp space scope. Phase 2a reads this to know which spaces a
// workspace covers (coverage check + Clicksy backfill trigger). Maps match
// Clicksy's `workspace_spaces` exactly. Read-only.
model WorkspaceSpace {
  id                   String   @id @default(cuid())
  workspaceId          String   @map("workspace_id")
  spaceId              String   @map("space_id")
  name                 String
  backfillLookbackDays Int      @default(30) @map("backfill_lookback_days")
  enabled              Boolean  @default(true)

  @@unique([workspaceId, spaceId])
  @@index([workspaceId])
  @@map("workspace_spaces")
  @@schema("public")
}

// Clicksy's mirrored ClickUp tasks — the KB embed source. Maps match Clicksy's
// `clickup_tasks` exactly; Phase 2a reads the descriptive fields + the comment-
// completeness markers (`commentsSyncedAt` debounces comment folding). Read-only.
model ClickupTask {
  taskId           String    @id @map("task_id")
  workspaceId      String    @map("workspace_id")
  taskName         String    @map("task_name")
  description      String?
  url              String?
  status           String?
  statusType       String?   @map("status_type")
  priority         String?
  isDeleted        Boolean   @default(false) @map("is_deleted")
  spaceId          String?   @map("space_id")
  spaceName        String?   @map("space_name")
  folderName       String?   @map("folder_name")
  listId           String?   @map("list_id")
  listName         String?   @map("list_name")
  assigneesNames   String?   @map("assignees_names")
  assigneesEmails  String?   @map("assignees_emails")
  executiveName    String?   @map("executive_name")
  department       String?
  client           String?
  sprintName       String?   @map("sprint_name")
  estimation       Decimal?  @map("estimation")
  tags             String?
  createdDate      DateTime? @map("created_date")
  updatedDate      DateTime? @map("updated_date")
  closedDate       DateTime? @map("closed_date")
  dueDate          DateTime? @map("due_date")
  startDate        DateTime? @map("start_date")
  commentsSyncedAt DateTime? @map("comments_synced_at")
  commentCount     Int       @default(0) @map("comment_count")

  @@index([workspaceId, spaceId])
  @@index([updatedDate])
  @@map("clickup_tasks")
  @@schema("public")
}

// Clicksy's mirrored ClickUp task comments (the 2.0 table). Folded into a task's
// card once `ClickupTask.commentsSyncedAt` is set. Read-only.
model ClickupTaskComment {
  commentId    String    @id @map("comment_id")
  workspaceId  String    @map("workspace_id")
  taskId       String    @map("task_id")
  commentText  String?   @map("comment_text")
  userId       String?   @map("user_id")
  userName     String?   @map("user_name")
  userEmail    String?   @map("user_email")
  commentDate  DateTime? @map("comment_date")
  isDeleted    Boolean   @default(false) @map("is_deleted")

  @@index([taskId])
  @@map("clickup_task_comments")
  @@schema("public")
}

// Minimal read-only mirrors reserved for later phases (status history / time).
model ClickupTaskEvent {
  id          BigInt   @id @default(autoincrement())
  workspaceId String   @map("workspace_id")
  taskId      String   @map("task_id")
  eventType   String   @map("event_type")
  occurredAt  DateTime @map("occurred_at")
  // Before/after snapshots of the changed field(s) — 2a.1 reads these to detect
  // reopened (closed→open status) transitions for the blockers fact. Shape is
  // Clicksy-defined JSON; the reopened query degrades to 0 if it doesn't match.
  before      Json?
  after       Json?

  @@index([taskId, occurredAt])
  @@map("clickup_task_events")
  @@schema("public")
}

model ClickupTimeEntry {
  timeEntryId   String    @id @map("time_entry_id")
  workspaceId   String    @map("workspace_id")
  taskId        String?   @map("task_id")
  userId        String?   @map("user_id")
  userName      String?   @map("user_name")
  userEmail     String?   @map("user_email")
  startTime     DateTime? @map("start_time")
  // Decimal hours per entry (Clicksy converts ClickUp ms → hours). 2a.1 sums this
  // per user over the workload window.
  durationHours Decimal   @default(0) @map("duration_hours") @db.Decimal(12, 4)

  @@index([taskId])
  @@map("clickup_time_entries")
  @@schema("public")
}

// Clicksy's per-job operational log. Phase 2a reads completed backfill rows
// (`queue_name='clickup-backfills'`, `entity_type='space'`) to derive the
// already-mirrored window per space for the coverage check. Read-only.
model SyncJobLog {
  id          BigInt    @id @default(autoincrement())
  workspaceId String?   @map("workspace_id")
  queueName   String    @map("queue_name")
  jobName     String    @map("job_name")
  status      String
  entityType  String?   @map("entity_type")
  entityId    String?   @map("entity_id")
  payload     Json?
  startedAt   DateTime? @map("started_at")
  finishedAt  DateTime? @map("finished_at")
  tasksSynced Int?      @map("tasks_synced")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([queueName, jobName])
  @@index([workspaceId, createdAt])
  @@map("sync_job_logs")
  @@schema("public")
}
