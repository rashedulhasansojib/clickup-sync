# Vite dev-mode env (loaded by `vite` / `pnpm --filter web dev`, NOT by `vite build`).
# Non-secret — committed so the Clicksy→Meetsy entry point "just works" in local dev.
#
# Points the sidebar "Meetsy" link + the /login round-trip allowlist at the
# Meetsy web app's dev origin (next dev -p 3001). Prod bakes this via a Docker
# build-arg instead (see Dockerfile / docker-compose.prod.yml).
VITE_MEETSY_WEB_ORIGIN=http://localhost:3001
