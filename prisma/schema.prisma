generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model ClickupTask {
  taskId          String   @id @map("task_id")
  workspaceId     String   @map("workspace_id")
  parentTaskId    String?  @map("parent_task_id")
  taskName        String   @map("task_name")
  description     String?
  url             String?
  status          String?
  statusType      String?  @map("status_type")
  statusColor     String?  @map("status_color")
  priority        String?
  orderIndex      Int?     @map("order_index")
  archived        Boolean  @default(false)
  isDeleted       Boolean  @default(false) @map("is_deleted")
  createdDate     DateTime? @map("created_date")
  updatedDate     DateTime? @map("updated_date")
  closedDate      DateTime? @map("closed_date")
  dueDate         DateTime? @map("due_date")
  startDate       DateTime? @map("start_date")
  deletedAt       DateTime? @map("deleted_at")
  syncedAt        DateTime @default(now()) @updatedAt @map("synced_at")
  syncCount       Int      @default(0) @map("sync_count")
  timeEstimate    BigInt?  @map("time_estimate")
  timeSpent       BigInt?  @map("time_spent")
  spaceId         String?  @map("space_id")
  spaceName       String?  @map("space_name")
  folderId        String?  @map("folder_id")
  folderName      String?  @map("folder_name")
  listId          String?  @map("list_id")
  listName        String?  @map("list_name")
  assigneesNames  String?  @map("assignees_names")
  assigneesEmails String?  @map("assignees_emails")
  watchersNames   String?  @map("watchers_names")
  watchersEmails  String?  @map("watchers_emails")
  creatorId       String?  @map("creator_id")
  creatorName     String?  @map("creator_name")
  executiveName   String?  @map("executive_name")
  department      String?
  client          String?
  cost            Decimal  @default(0) @db.Decimal(14, 2)
  estimation      Decimal  @default(0) @db.Decimal(14, 2)
  sprintName      String?  @map("sprint_name")
  sprintPoints    Int      @default(0) @map("sprint_points")
  tags            String?
  customTags      String?  @map("custom_tags")
  // Comment-completeness markers, set once a task's comment sync finishes (see
  // CommentsService). Lets downstream consumers (Meetsy's KB) re-embed a task
  // once its comments are complete instead of once per paginated page.
  commentsSyncedAt DateTime? @map("comments_synced_at")
  commentCount     Int       @default(0) @map("comment_count")
  raw             Json?

  timeEntries     ClickupTimeEntry[]

  @@index([parentTaskId])
  @@index([spaceId])
  @@index([updatedDate])
  @@index([workspaceId, spaceId])
  @@map("clickup_tasks")
}

model ClickupTimeEntry {
  timeEntryId      String   @id @map("time_entry_id")
  workspaceId      String   @map("workspace_id")
  taskId           String?  @map("task_id")
  userId           String?  @map("user_id")
  userName         String?  @map("user_name")
  userEmail        String?  @map("user_email")
  startTime        DateTime? @map("start_time")
  endTime          DateTime? @map("end_time")
  durationHours    Decimal  @default(0) @map("duration_hours") @db.Decimal(12, 4)
  billable         Boolean  @default(false)
  description      String?
  rateId           BigInt?  @map("rate_id")
  currency         String   @default("AUD")
  hourlyRateCents  BigInt   @default(0) @map("hourly_rate_cents")
  costCents        BigInt   @default(0) @map("cost_cents")
  status           String   @default("SYNCED")
  raw              Json?
  syncedAt         DateTime @default(now()) @updatedAt @map("synced_at")

  task             ClickupTask? @relation(fields: [taskId], references: [taskId], onDelete: SetNull)
  rate             AssigneeRate? @relation(fields: [rateId], references: [rateId], onDelete: SetNull)

  @@index([taskId])
  @@index([userId])
  @@index([startTime])
  @@index([workspaceId, startTime])
  @@map("clickup_time_entries")
}

model AssigneeRate {
  rateId           BigInt   @id @default(autoincrement()) @map("rate_id")
  assigneeId       String   @map("assignee_id")
  assigneeName     String?  @map("assignee_name")
  assigneeEmail    String?  @map("assignee_email")
  currency         String   @default("AUD")
  hourlyRateCents  BigInt   @map("hourly_rate_cents")
  validFrom        DateTime @map("valid_from") @db.Date
  validTo          DateTime? @map("valid_to") @db.Date
  updatedAt        DateTime @default(now()) @updatedAt @map("updated_at")

  timeEntries      ClickupTimeEntry[]

  @@unique([assigneeId, validFrom])
  @@index([assigneeId, validFrom, validTo])
  @@map("assignee_rates")
}

model ClientBudget {
  budgetId           BigInt    @id @default(autoincrement()) @map("budget_id")
  client             String
  monthlyAmountCents BigInt    @map("monthly_amount_cents")
  currency           String    @default("USD")
  validFrom          DateTime  @map("valid_from") @db.Date
  validTo            DateTime? @map("valid_to")  @db.Date
  notes              String?
  updatedAt          DateTime  @default(now()) @updatedAt @map("updated_at")

  @@unique([client, validFrom])
  @@index([client, validFrom, validTo])
  @@map("client_budgets")
}

model ClickupWebhookEvent {
  id           BigInt   @id @default(autoincrement())
  workspaceId  String   @map("workspace_id")
  fingerprint  String   @unique
  eventType    String?  @map("event_type")
  taskId       String?  @map("task_id")
  rawPayload   Json     @map("raw_payload")
  status       String   @default("received")
  receivedAt   DateTime @default(now()) @map("received_at")
  processedAt  DateTime? @map("processed_at")
  errorMessage String?  @map("error_message")

  @@index([eventType])
  @@index([taskId])
  @@index([receivedAt])
  @@index([workspaceId, receivedAt])
  @@map("clickup_webhook_events")
}

model ClickupWebhookSeen {
  fingerprint String   @id
  workspaceId String   @map("workspace_id")
  seenAt      DateTime @default(now()) @map("seen_at")
  @@map("clickup_webhook_seen")
}

// Single-row table (id = "singleton") holding APP-GLOBAL, non-connection
// preferences only (notifications, cost/costing rules, failure-retry). The
// per-connection ClickUp settings (team id, API token, webhook secret/endpoint/
// events, spike-hours cap, per-space scope) moved to the per-workspace
// `Workspace` / `WorkspaceSpace` tables when multi-workspace support landed.
model AppSettings {
  id          String   @id @default("singleton")
  preferences Json?    @map("preferences")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")
  updatedBy   String?  @map("updated_by")

  @@map("app_settings")
}

model SyncCheckpoint {
  id                     BigInt   @id @default(autoincrement())
  workspaceId            String   @map("workspace_id")
  source                 String
  scopeType              String   @map("scope_type")
  scopeId                String   @map("scope_id")
  lastSuccessfulSyncAt   DateTime? @map("last_successful_sync_at")
  lastAttemptedSyncAt    DateTime? @map("last_attempted_sync_at")
  updatedAt              DateTime @default(now()) @updatedAt @map("updated_at")

  @@unique([workspaceId, source, scopeType, scopeId])
  @@map("sync_checkpoints")
}

model SyncJobLog {
  id           BigInt   @id @default(autoincrement())
  workspaceId  String?  @map("workspace_id") // nullable: global/maintenance jobs (e.g. cost recalc) span all workspaces
  jobId        String?  @map("job_id")
  queueName    String   @map("queue_name")
  jobName      String   @map("job_name")
  status       String
  entityType   String?  @map("entity_type")
  entityId     String?  @map("entity_id")
  attemptsMade Int      @default(0) @map("attempts_made")
  errorMessage String?  @map("error_message")
  errorStack   String?  @map("error_stack")
  payload      Json?
  startedAt         DateTime? @map("started_at")
  finishedAt        DateTime? @map("finished_at")
  tasksSynced       Int?      @map("tasks_synced")
  timeEntriesSynced Int?      @map("time_entries_synced")
  createdAt         DateTime  @default(now()) @map("created_at")

  @@index([queueName, jobName])
  @@index([status])
  @@index([entityType, entityId])
  @@index([workspaceId, createdAt])
  @@map("sync_job_logs")
}

model DeadLetterJob {
  id           BigInt   @id @default(autoincrement())
  workspaceId  String?  @map("workspace_id") // nullable: global/maintenance jobs span all workspaces
  queueName    String   @map("queue_name")
  jobName      String   @map("job_name")
  entityType   String?  @map("entity_type")
  entityId     String?  @map("entity_id")
  payload      Json
  errorMessage String?  @map("error_message")
  errorStack   String?  @map("error_stack")
  attemptsMade Int?     @map("attempts_made")
  failedAt     DateTime @default(now()) @map("failed_at")
  retriedAt    DateTime? @map("retried_at")
  resolvedAt   DateTime? @map("resolved_at")

  @@index([queueName, jobName])
  @@index([entityType, entityId])
  @@index([workspaceId, failedAt])
  @@map("dead_letter_jobs")
}

model TagAssigneeMap {
  id              BigInt   @id @default(autoincrement())
  tagName         String   @unique @map("tag_name")
  clickupUserId   String   @map("clickup_user_id")
  clickupUserName String?  @map("clickup_user_name")
  clickupEmail    String?  @map("clickup_email")
  active          Boolean  @default(true)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("tag_assignee_map")
}

model TimeEntryReplacement {
  id                 BigInt   @id @default(autoincrement())
  workspaceId        String   @map("workspace_id")
  originalEntryId    String   @unique @map("original_entry_id")
  replacementEntryId String?  @map("replacement_entry_id")
  taskId             String?  @map("task_id")
  originalUserId     String?  @map("original_user_id")
  replacedUserId     String?  @map("replaced_user_id")
  tagName            String?  @map("tag_name")
  status             String   @default("replaced")
  errorMessage       String?  @map("error_message")
  replacedAt         DateTime @default(now()) @map("replaced_at")

  @@index([taskId])
  @@index([originalUserId])
  @@map("time_entry_replacements")
}

model SpikeNotification {
  id             BigInt   @id @default(autoincrement())
  workspaceId    String   @map("workspace_id")
  clickupUserId  String   @map("clickup_user_id")
  spikeDate      DateTime @map("spike_date") @db.Date
  recipientEmail String   @map("recipient_email")
  userName       String?  @map("user_name")
  totalHours     Decimal  @default(0) @map("total_hours") @db.Decimal(12, 4)
  rule           String?
  note           String?
  sentBy         String?  @map("sent_by")
  sentAt         DateTime @default(now()) @map("sent_at")

  @@unique([workspaceId, clickupUserId, spikeDate])
  @@map("spike_notifications")
}

model SpikeResolution {
  id            BigInt   @id @default(autoincrement())
  workspaceId   String   @map("workspace_id")
  clickupUserId String   @map("clickup_user_id")
  spikeDate     DateTime @map("spike_date") @db.Date
  userName      String?  @map("user_name")
  note          String?
  resolvedBy    String?  @map("resolved_by")
  resolvedAt    DateTime @default(now()) @map("resolved_at")

  @@unique([workspaceId, clickupUserId, spikeDate])
  @@map("spike_resolutions")
}

model AdminAuditLog {
  id           BigInt   @id @default(autoincrement())
  occurredAt   DateTime @default(now()) @map("occurred_at")
  actor        String?
  method       String
  path         String
  routePattern String?  @map("route_pattern")
  statusCode   Int      @map("status_code")
  durationMs   Int?     @map("duration_ms")
  ip           String?
  userAgent    String?  @map("user_agent")
  requestBody  Json?    @map("request_body")
  errorMessage String?  @map("error_message")

  @@index([occurredAt])
  @@index([actor, occurredAt])
  @@index([routePattern, occurredAt])
  @@map("admin_audit_log")
}

model ClickupTaskEvent {
  id                BigInt   @id @default(autoincrement())
  workspaceId       String   @map("workspace_id")
  taskId            String   @map("task_id")
  eventType         String   @map("event_type")
  occurredAt        DateTime @map("occurred_at")
  changedByUserId   String?  @map("changed_by_user_id")
  changedByUserName String?  @map("changed_by_user_name")
  before            Json?
  after             Json?
  fingerprint       String   @unique
  raw               Json?

  @@index([taskId, occurredAt])
  @@index([eventType, occurredAt])
  @@index([workspaceId, occurredAt])
  @@map("clickup_task_events")
}

// ClickUp task comments. Modeled on ClickupTaskEvent (the no-FK append-log
// pattern), NOT ClickupTimeEntry: `taskId` is a plain indexed reference with NO
// Prisma relation / no foreign key, because a `taskCommentPosted` webhook can
// arrive before the task is mirrored and a real FK would throw on insert.
// `parentCommentId` is kept nullable so threaded replies can slot in later.
model ClickupTaskComment {
  commentId        String    @id @map("comment_id")
  workspaceId      String    @map("workspace_id")
  taskId           String    @map("task_id")
  // TODO(replies): threaded replies (ClickUp has no reply webhook; needs an N+1
  // GET /comment/{id}/reply) will populate parent_comment_id — Phase 1.x.
  parentCommentId  String?   @map("parent_comment_id")
  commentText      String?   @map("comment_text")
  userId           String?   @map("user_id")
  userName         String?   @map("user_name")
  userEmail        String?   @map("user_email")
  resolved         Boolean   @default(false)
  assigneeId       String?   @map("assignee_id")
  assigneeName     String?   @map("assignee_name")
  replyCount       Int       @default(0) @map("reply_count")
  reactions        Json?
  commentDate      DateTime? @map("comment_date")
  isDeleted        Boolean   @default(false) @map("is_deleted")
  deletedAt        DateTime? @map("deleted_at")
  syncedAt         DateTime  @default(now()) @updatedAt @map("synced_at")
  syncCount        Int       @default(0) @map("sync_count")
  raw              Json?

  @@index([taskId])
  @@index([workspaceId, commentDate])
  @@map("clickup_task_comments")
}

// ---------------------------------------------------------------------------
// Auth: Organizations, Users, Invitations, Sessions
// ---------------------------------------------------------------------------

enum Role {
  OWNER
  ADMIN
  MEMBER
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  users       User[]
  invitations Invitation[]
  workspaces  Workspace[]

  @@map("organizations")
}

enum WorkspaceStatus {
  ACTIVE
  DISABLED
}

// A connected ClickUp workspace (sync source). One org can connect many; each
// renders as its own isolated dashboard. Holds the per-workspace ClickUp
// connection settings that previously lived in the singleton `app_settings` row.
// Secret columns hold AES-256-GCM ciphertext (see CryptoService), same as before.
model Workspace {
  id                 String          @id @default(cuid())
  orgId              String          @map("org_id")
  name               String
  clickupTeamId      String          @map("clickup_team_id")
  clickupApiTokenEnc String?         @map("clickup_api_token_enc")
  webhookSecretEnc   String?         @map("webhook_secret_enc")
  webhookEndpoint    String?         @map("webhook_endpoint")
  webhookEvents      String?         @map("webhook_events")
  webhookId          String?         @map("webhook_id")
  spikeHoursCap      Int             @default(12) @map("spike_hours_cap")
  preferences        Json?
  isDefault          Boolean         @default(false) @map("is_default")
  status             WorkspaceStatus @default(ACTIVE)
  createdAt          DateTime        @default(now()) @map("created_at")
  updatedAt          DateTime        @default(now()) @updatedAt @map("updated_at")
  updatedBy          String?         @map("updated_by")

  org    Organization     @relation(fields: [orgId], references: [id])
  spaces WorkspaceSpace[]

  @@index([orgId])
  @@map("workspaces")
}

// Per-workspace ClickUp space scope. Replaces the hardcoded CLICKUP_SPACES config.
model WorkspaceSpace {
  id                   String   @id @default(cuid())
  workspaceId          String   @map("workspace_id")
  spaceId              String   @map("space_id")
  name                 String
  backfillLookbackDays Int      @default(30) @map("backfill_lookback_days")
  enabled              Boolean  @default(true)
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @default(now()) @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, spaceId])
  @@index([workspaceId])
  @@map("workspace_spaces")
}

model User {
  id           String     @id @default(cuid())
  orgId        String     @map("org_id")
  email        String     @unique
  passwordHash String     @map("password_hash")
  name         String?
  role         Role       @default(MEMBER)
  status       UserStatus @default(ACTIVE)
  lastLoginAt  DateTime?  @map("last_login_at")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @default(now()) @updatedAt @map("updated_at")

  org      Organization @relation(fields: [orgId], references: [id])
  sessions Session[]

  @@index([orgId])
  @@map("users")
}

model Invitation {
  id              String           @id @default(cuid())
  orgId           String           @map("org_id")
  email           String
  role            Role
  tokenHash       String           @unique @map("token_hash")
  invitedByUserId String?          @map("invited_by_user_id")
  status          InvitationStatus @default(PENDING)
  expiresAt       DateTime         @map("expires_at")
  acceptedAt      DateTime?        @map("accepted_at")
  createdAt       DateTime         @default(now()) @map("created_at")

  org Organization @relation(fields: [orgId], references: [id])

  @@index([email])
  @@index([orgId, status])
  @@map("invitations")
}

model Session {
  id         String    @id @default(cuid())
  userId     String    @map("user_id")
  tokenHash  String    @unique @map("token_hash")
  expiresAt  DateTime  @map("expires_at")
  lastSeenAt DateTime? @map("last_seen_at")
  ip         String?
  userAgent  String?   @map("user_agent")
  createdAt  DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}
